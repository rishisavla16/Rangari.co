# Required for Vercel Functions and the admin API
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# First-login bootstrap only. Remove these after the first administrator is created.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-this-before-deploying

# Added by Vercel Blob when you create a Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
